# ═══════════════════════════════════════════════════════════
#  AmpireVPN — настройки. Скопируйте в .env:  cp .env.example .env
#  Все пароли/секреты ниже сгенерируйте:  openssl rand -hex 24
# ═══════════════════════════════════════════════════════════

# ───────── Режим окружения ─────────
# production — строгие проверки при старте: бот НЕ запустится с WEBHOOK_SECRET=change-me, пустым OWNER_IDS,
#              паролем БД по умолчанию, http:// в PUBLIC_BASE_URL, без токена панели, тарифом без сквадов
#              или при ошибке миграций БД. development — те же проблемы лишь предупреждения.
APP_ENV=production

# ───────── Telegram ─────────
# Токен от @BotFather
BOT_TOKEN=
# Telegram ID владельцев через запятую (узнать: @userinfobot). Владельцам доступно ВСЁ.
OWNER_IDS=
# Чат поддержки — кнопка «Написать в поддержку» (можно поменять в админке → Настройки)
SUPPORT_URL=https://t.me/your_support
# Ссылки на документы и FAQ. Пока пусто — стоят ссылки-заглушки (telegra.ph/AmpireVPN-…).
# Замените на боевые страницы; тексты оферты, политики, автопродления и возврата согласуйте с юристом.
# Можно менять и позже в админке: Настройки → Документы и FAQ.
FAQ_URL=
LEGAL_OFFER_URL=
LEGAL_PRIVACY_URL=
LEGAL_TERMS_URL=
LEGAL_PD_URL=
LEGAL_AUTOPAY_URL=
LEGAL_REFUND_URL=

# ───────── Публичный адрес бота ─────────
# Домен, который смотрит на этот сервер (HTTPS обязателен). Нужен для вебхуков (ЮKassa, CryptoBot, Telegram)
# и для страниц /dl и /add (кнопки «Скачать Happ» и «Добавить подписку»).
BOT_DOMAIN=bot.example.com
PUBLIC_BASE_URL=https://bot.example.com
# Случайная строка — часть адреса вебхуков (защита от посторонних запросов)
WEBHOOK_SECRET=

# ───────── База данных ─────────
# Пароль PostgreSQL (только буквы и цифры, например hex). Используется compose-файлом.
POSTGRES_PASSWORD=
# Имя пользователя/базы. По умолчанию ampire. Если том БД создан прежней версией (celeste) — укажите celeste/celeste.
POSTGRES_USER=ampire
POSTGRES_DB=ampire

# ───────── Общее ─────────
TIMEZONE=Europe/Moscow
LOG_LEVEL=INFO
# Логи в JSON (для Loki/ELK/Datadog)
LOG_JSON=false
# Мониторинг ошибок (необязательно): https://sentry.io → DSN проекта
SENTRY_DSN=

# ───────── Режим работы и масштабирование (подробно: docs/SCALING.md) ─────────
# all    — всё в одном процессе (по умолчанию, для небольших установок)
# api    — приём запросов + Telegram webhook (несколько реплик), только с TELEGRAM_MODE=webhook
# worker — только фоновые задачи (напоминания, истечение, платежи, рассылки, автопродление, бэкапы)
APP_ROLE=all
# polling — бот сам опрашивает Telegram (одна реплика); webhook — Telegram присылает апдейты (можно много реплик)
TELEGRAM_MODE=polling
# Соединений с БД на процесс (всего = процессы × (POOL + OVERFLOW) — должно быть меньше max_connections PostgreSQL)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
# Сколько секунд ждать свободное соединение из пула — дальше ошибка (а не зависание всего бота)
DB_POOL_TIMEOUT=5
# Серверные таймауты PostgreSQL: один запрос и «простой» внутри открытой транзакции (мс; 0 — выключить).
# С PgBouncer эти параметры не передаются — задайте их на роли БД:  ALTER ROLE ampire SET statement_timeout='30s';
DB_STATEMENT_TIMEOUT_MS=30000
DB_IDLE_TX_TIMEOUT_MS=60000
# true, если между ботом и PostgreSQL стоит PgBouncer в режиме transaction
DB_PGBOUNCER=false
# Прямой адрес БД для миграций (нужен при PgBouncer; иначе пусто)
MIGRATION_DATABASE_URL=
# Лимиты сообщений Telegram в секунду на ВСЕ реплики вместе (общий лимит Telegram ≈ 30/с). Корзины раздельные,
# чтобы рассылка не задерживала уведомления об оплате: TG_BROADCAST_RATE + TG_BG_RATE ≤ ~28.
TG_BROADCAST_RATE=18
TG_BG_RATE=8
# Параллельных отправителей рассылки на процесс
BROADCAST_CONCURRENCY=16
# Одновременных запросов к панели Remnawave на процесс и таймаут, сек
PANEL_CONCURRENCY=20
PANEL_TIMEOUT=15
# Запросов в минуту с одного IP к публичным страницам /dl и /add
WEB_RATE_PER_MIN=90
# Доверять X-Forwarded-For от реверс-прокси (true, если бот стоит за Caddy/Nginx)
TRUSTED_PROXY=true
# Токен для /metrics (формат Prometheus), передаётся ТОЛЬКО в заголовке Authorization: Bearer. Пусто — эндпоинт выключен.
METRICS_TOKEN=

# ───────── Remnawave (панель VPN) ─────────
# Адрес панели. Проще всего публичный: https://panel.example.com
# Если бот в одной docker-сети с панелью: http://remnawave:3000
REMNAWAVE_URL=https://panel.example.com
# Токен: Панель → Settings → API Tokens → Create (с правами на users, hwid, squads, nodes, system)
REMNAWAVE_TOKEN=
# Бот добавляет X-Forwarded-For/Proto: https — нужно при доступе по http напрямую. Оставь true.
REMNAWAVE_PROXY_HEADERS=true
# Только если панель закрыта защитой (иначе пусто):
#   Caddy Security → ключ в заголовок X-Api-Key;  cookie-защита → name=value
REMNAWAVE_CADDY_KEY=
REMNAWAVE_COOKIE=
# Секрет вебхуков Remnawave = WEBHOOK_SECRET_HEADER из .env панели (необязательно, но желательно)
REMNAWAVE_WEBHOOK_SECRET=

# Сквады для тарифов можно выбрать позже в админке (Тарифы → Сквады).
# Здесь — необязательное начальное значение (UUID через запятую).
# В production бот не запустится, если у включённого тарифа нет сквадов (иначе подписка выдавалась бы без серверов).
# ALLOW_EMPTY_SQUADS=true — только для первичной настройки: такой тариф не продаётся и не выдаётся.
LITE_SQUADS=
PREMIUM_SQUADS=
ALLOW_EMPTY_SQUADS=false

# ───────── ЮKassa (карты, СБП, автопродление) ─────────
# Личный кабинет ЮKassa → Интеграция → Ключи API
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Передавать данные чека (54-ФЗ для ИП/ООО или автоотправка для самозанятых). Бот попросит email.
YOOKASSA_RECEIPTS=true
# Ставка НДС в чеке: 1 = без НДС (самозанятые, УСН без НДС). Остальные коды — в документации ЮKassa (раздел «Чеки»).
YOOKASSA_VAT_CODE=1
# Система налогообложения (нужна, только если в магазине их несколько): 1 ОСН, 2 УСН доходы, 3 УСН доходы-расходы, 4 ЕНВД, 5 ЕСХН, 6 Патент
YOOKASSA_TAX_SYSTEM_CODE=
# Принимать уведомления только с IP-адресов ЮKassa (нужен реверс-прокси, передающий X-Forwarded-For)
YOOKASSA_CHECK_IP=false

# ───────── CryptoBot (оплата криптовалютой) ─────────
# @CryptoBot → Crypto Pay → Create App → API Token (формат 123456:AAxxxx). Пусто — оплата криптой выключена.
CRYPTOBOT_TOKEN=
# true — тестовая сеть (токен из @CryptoTestnetBot)
CRYPTOBOT_TESTNET=false
# Какие монеты принимать, через запятую (USDT,TON,BTC,ETH,LTC,TRX,USDC,BNB). Пусто — все.
CRYPTOBOT_ASSETS=

# Сверка «ЮKassa → БД»: в какой час (по TIMEZONE) раз в сутки проверять, что все успешные платежи учтены
YOOKASSA_RECON_HOUR=5

# ───────── Резервные копии ─────────
# ОСНОВНОЕ — непрерывный архив WAL (PITR) + копия вне сервера: docker-compose.backup.yml, docs/BACKUP.md.
# Дамп в Telegram — дополнительная копия «под рукой»; он отправляется ТОЛЬКО зашифрованным (нужен BACKUP_PASSWORD).
BACKUP_TELEGRAM=true
# В какой час (по TIMEZONE) раз в сутки присылать зашифрованный дамп владельцам
BACKUP_HOUR=4
# Или в конкретный чат/канал (бот должен быть админом):
BACKUP_CHAT_ID=
# Пароль шифрования дампа. Без него дамп НЕ отправляется. Расшифровка: python scripts/decrypt_backup.py
BACKUP_PASSWORD=
# Алерт, если свежей копии (PITR или дамп) нет дольше стольких часов
BACKUP_MAX_AGE_H=36

# --- PITR (pgBackRest) — переменные для docker-compose.backup.yml ---
# S3-совместимое хранилище на ДРУГОЙ площадке/у другого провайдера (Yandex Object Storage, Selectel, Backblaze B2, MinIO…)
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=ru-central1
BACKUP_S3_KEY=
BACKUP_S3_SECRET=
# host (по умолчанию) или path (MinIO и некоторые провайдеры)
BACKUP_S3_URI_STYLE=host
# Пароль шифрования репозитория. ХРАНИТЕ ОТДЕЛЬНО от сервера: без него копии не расшифровать никогда.
BACKUP_REPO_PASSPHRASE=
# Час (UTC) ежедневной копии
BACKUP_HOUR_UTC=1

# ───────── Мониторинг (docker-compose.monitoring.yml) ─────────
# Куда слать алерты Prometheus: Telegram ID или ID чата (бот-отправитель — ALERT_BOT_TOKEN, по умолчанию BOT_TOKEN)
ALERT_CHAT_ID=
ALERT_BOT_TOKEN=
